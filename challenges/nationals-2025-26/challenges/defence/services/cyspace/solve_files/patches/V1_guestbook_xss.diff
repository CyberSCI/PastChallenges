# V1 — Guestbook stored XSS (EASY)
#
# Fix: HTML-encode the comment body before rendering. Both render sites
# (guestbook.php and profile.php's inline comments) use the same vulnerable
# `<?php echo $row['body']; ?>` pattern; both are wrapped with the existing
# `h()` helper (htmlspecialchars with ENT_QUOTES + UTF-8, see inc/session.php).
#
# Apply from inside release_files/:
#     patch -p1 < ../solve_files/patches/V1_guestbook_xss.diff
#
diff --git a/src/guestbook.php b/src/guestbook.php
--- a/src/guestbook.php
+++ b/src/guestbook.php
@@ -79,7 +79,7 @@ require __DIR__ . '/inc/header.php';
       <span class="comment-author"><?php echo h($row['author']); ?></span>
       <span class="comment-time">&mdash; <?php echo h($row['created_at']); ?></span>
       <div class="comment-body">
-      <?php echo $row['body']; ?>
+      <?php echo h($row['body']); ?>
       </div>
     </td>
   </tr>
diff --git a/src/profile.php b/src/profile.php
--- a/src/profile.php
+++ b/src/profile.php
@@ -306,7 +306,7 @@ require __DIR__ . '/inc/header.php';
         <span class="comment-author"><?php echo h($row['author']); ?></span>
         <span class="comment-time">&mdash; <?php echo h($row['created_at']); ?></span>
         <div class="comment-body">
-        <?php echo $row['body']; ?>
+        <?php echo h($row['body']); ?>
         </div>
       </td>
     </tr>
