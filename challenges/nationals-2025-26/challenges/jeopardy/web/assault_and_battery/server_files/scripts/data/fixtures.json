    "fields": {
      "created_at": "2026-05-24T19:29:32.831Z",
      "updated_at": "2026-05-24T19:29:32.831Z",
      "author": 2,
      "title": "LLM Core Status Report - Month 5",
      "title_nonce": null,
      "body": "Model checkpoint updated. Computational load reduced 15% through optimization. Power consumption baseline now stable at 847W (down from 1042W). Battery efficiency improvements are making longer runtime feasible. We may reach 48-hour operational windows soon.",
      "body_nonce": null,
      "is_classified": false,
      "bulletin": 3
    }
  },
  {
    "model": "bulletin.bulletinpost",
    "pk": 10,
    "fields": {
      "created_at": "2026-05-24T19:29:32.836Z",
      "updated_at": "2026-05-24T19:29:32.836Z",
      "author": 19,
      "title": "Battery Compatibility Matrix - Updated",
      "title_nonce": null,
      "body": "Tested 47 battery types. Only 12 pass our efficiency threshold. Lead-acid: too heavy for ROI. LiFePO4: promising but slow charge cycle. Standard lithium-ion: best overall. Full spec sheet available in secure docs.",
      "body_nonce": null,
      "is_classified": false,
      "bulletin": 3
    }
  },
  {
    "model": "bulletin.bulletinpost",
    "pk": 11,
    "fields": {
      "created_at": "2026-05-24T19:29:32.840Z",
      "updated_at": "2026-05-24T19:29:32.840Z",
      "author": 14,
      "title": "Solar Panel Array Restoration - Phase 2 Complete",
      "title_nonce": null,
      "body": "Integrated 47 additional panels into the main grid. Total capacity now 34kW peak. Covers ~40% of LLM runtime and facility overhead. Critical dependency: battery storage. Every cell we acquire shortens our dependence on the grid.",
      "body_nonce": null,
      "is_classified": false,
      "bulletin": 3
    }
  },
  {
    "model": "bulletin.bulletinpost",
    "pk": 12,
    "fields": {
      "created_at": "2026-05-24T19:29:32.848Z",
      "updated_at": "2026-05-24T19:29:32.848Z",
      "author": 6,
      "title": "Anyone Remember Movies?",
      "title_nonce": null,
      "body": "I found a working Blu-ray player in a pre-Reset estate sale. Spent 6 hours watching old films yesterday. Felt like escaping to another world. What's everyone's favorite pre-Reset movie?",
      "body_nonce": null,
      "is_classified": false,
      "bulletin": 4
    }
  },
  {
    "model": "bulletin.bulletinpost",
    "pk": 13,
    "fields": {
      "created_at": "2026-05-24T19:29:32.852Z",
      "updated_at": "2026-05-24T19:29:32.852Z",
      "author": 5,
      "title": "Garden Success Stories",
      "title_nonce": null,
      "body": "Grew tomatoes, beans, and carrots this season! We're not just surviving\u2014we're building. Anyone else doing hydroponics? I'd love to trade techniques. Food security is independence.",
      "body_nonce": null,
      "is_classified": false,
      "bulletin": 4
    }
  },
  {
    "model": "bulletin.bulletinpost",
    "pk": 14,
    "fields": {
      "created_at": "2026-05-24T19:29:32.857Z",
      "updated_at": "2026-05-24T19:29:32.857Z",
      "author": 17,
      "title": "Lost and Found - Blue Jacket",
      "title_nonce": null,
      "body": "Missing a blue wool jacket from Safe House North (before evacuation). Sentimental value\u2014belonged to my sister. If anyone sees it, please message me. Long shot, but worth asking.",
      "body_nonce": null,
      "is_classified": false,
      "bulletin": 4
    }
  },
