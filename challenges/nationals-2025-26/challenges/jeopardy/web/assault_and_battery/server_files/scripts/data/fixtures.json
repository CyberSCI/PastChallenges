  {
    "model": "bulletin.bulletinpost",
    "pk": 1,
    "fields": {
      "created_at": "2026-05-24T19:29:32.554Z",
      "updated_at": "2026-05-24T19:29:32.554Z",
      "author": 4,
      "title": "Welcome to Reclaimer Central",
      "title_nonce": null,
      "body": "This is our sanctuary. We remember the world before, and we're building the world after. Every battery we recover is a step toward restoring what was lost. The Cleansing Light says LLMs brought about the EMP\u2014we know that's a lie. We're here to prove it.",
      "body_nonce": null,
      "is_classified": false,
      "bulletin": 1
    }
  },
  {
    "model": "bulletin.bulletinpost",
    "pk": 2,
    "fields": {
      "created_at": "2026-05-24T19:29:32.559Z",
      "updated_at": "2026-05-24T19:29:32.559Z",
      "author": 10,
      "title": "Scavenging Routes - Post Updates Here",
      "title_nonce": null,
      "body": "Found a promising sector near the old data center. Reports suggest intact solar arrays still functional. Anyone else having luck finding pre-Reset infrastructure? Share locations and observations. Stay safe out there.",
      "body_nonce": null,
      "is_classified": false,
      "bulletin": 1
    }
  },
  {
    "model": "bulletin.bulletinpost",
    "pk": 3,
    "fields": {
      "created_at": "2026-05-24T19:29:32.563Z",
      "updated_at": "2026-05-24T19:29:32.563Z",
      "author": 9,
      "title": "Cleansing Light Checkpoint Expansion",
      "title_nonce": null,
      "body": "They've set up new patrols on Route 7. Avoid that area for at least a week. They're searching for 'LLM loving scum' again. We need to be more careful about our movements. Any intel on their next target?",
      "body_nonce": null,
      "is_classified": false,
      "bulletin": 1
    }
  },
  {
    "model": "bulletin.bulletinpost",
    "pk": 4,
    "fields": {
      "created_at": "2026-05-24T19:29:32.568Z",
      "updated_at": "2026-05-24T19:29:32.568Z",
      "author": 19,
      "title": "New Member Introduction Thread",
      "title_nonce": null,
      "body": "If you're new to the network, introduce yourself! Where are you from? What skills do you bring? How did you find us? This community runs on trust and cooperation. Welcome to the Reclaimers.",
      "body_nonce": null,
      "is_classified": false,
      "bulletin": 1
    }
  },
